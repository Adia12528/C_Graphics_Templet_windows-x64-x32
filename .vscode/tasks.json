{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: Build graphics.h program",
            "command": "C:\\TDM-GCC-64\\bin\\g++.exe",
            "args": [
                "-m32",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\Home\\build\\${fileBasenameNoExtension}.exe",
                "-lbgi",
                "-lgdi32",
                "-lcomdlg32",
                "-luuid",
                "-loleaut32",
                "-lole32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "Builds the active graphics.h source file using TDM-GCC-64 (32-bit mode) with BGI libraries"
        }
    ]
}